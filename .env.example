# Copy to `.env` and edit. Every setting in deepsecure/config/settings.py can be
# overridden with the DEEPSECURE_ prefix. Nested values use a double underscore.

# Database (default: SQLite file at data/deepsecure.db inside the repo)
# DEEPSECURE_DB_URL=sqlite:///data/deepsecure.db

# Logging: DEBUG | INFO | WARNING | ERROR
DEEPSECURE_LOG_LEVEL=INFO

# Compute device: auto | cpu | cuda | mps   (auto = cuda -> mps -> cpu)
DEEPSECURE_DEVICE=auto

# Risk thresholds on the fused fake probability (boundary values fall into the LOWER category)
DEEPSECURE_RISK_THRESHOLDS__SUSPICIOUS=0.40
DEEPSECURE_RISK_THRESHOLDS__MALICIOUS=0.70

# Fusion weights (renormalised over the modalities that are available)
DEEPSECURE_FUSION_WEIGHTS__VISUAL=0.45
DEEPSECURE_FUSION_WEIGHTS__AUDIO=0.35
DEEPSECURE_FUSION_WEIGHTS__LIPSYNC=0.20

# Upload limits
DEEPSECURE_MAX_UPLOAD_MB=200
DEEPSECURE_MIN_DURATION_S=1.0
DEEPSECURE_MAX_DURATION_S=600
